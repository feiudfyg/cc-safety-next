{
  "name": "@local/cc-safety-net",
  "version": "2.4.14",
  "private": true,
  "description": "A coding agent CLI hook - block destructive commands and secret file access",
  "keywords": [
    "opencode",
    "plugin",
    "safety",
    "security"
  ],
  "license": "AGPL-3.0-or-later",
  "bin": {
    "cc-safety-net": "dist/bin/cc-safety-net.js",
    "ccsn": "dist/bin/cc-safety-net.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./api": {
      "types": "./dist/api.d.ts",
      "import": "./dist/api.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "audit:dependencies": "pnpm audit",
    "build": "pnpm run clean && bun scripts/project-bun.ts scripts/build.ts",
    "build:types": "tsc --project tsconfig.build.json --emitDeclarationOnly --declaration",
    "verify:coverage": "bun run scripts/verify-coverage.ts",
    "clean": "rm -rf dist",
    "check": "pnpm run lint && pnpm run lint:comments && pnpm run format:check && pnpm run typecheck && bun test",
    "lint": "oxlint src tests scripts knip.ts",
    "lint:comments": "bun scripts/check-comments.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.gui.json --noEmit",
    "knip": "knip-bun --production",
    "check-duplicates": "jscpd src tests --threshold 0 --exit-code 1 --no-tips --reporters ai --ignore '**/*.svg' --ignore-pattern 'import\\s[\\s\\S]*?from\\s[^;]*;'",
    "test": "bun test",
    "test:coverage": "AGENT=1 bun test tests --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "cc-safety-net": "bun run src/entries/bin.ts",
    "lint:fix": "oxlint --fix src tests scripts knip.ts",
    "format": "oxfmt src tests scripts knip.ts .oxfmtrc.json .oxlintrc.json package.json tsconfig.json tsconfig.build.json tsconfig.gui.json assets/cc-safety-net.schema.json",
    "format:check": "oxfmt --check src tests scripts knip.ts .oxfmtrc.json .oxlintrc.json package.json tsconfig.json tsconfig.build.json tsconfig.gui.json assets/cc-safety-net.schema.json"
  },
  "devDependencies": {
    "@opencode/plugin": "2.0.6",
    "@types/bun": "1.3.14",
    "jscpd": "^5.0.14",
    "knip": "^6.32.0",
    "oxc-parser": "0.142.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.6"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": {
      "optional": true
    }
  },
  "overrides": {
    "@opentelemetry/core": "2.8.0",
    "js-yaml": "^4.3.1",
    "picomatch@^2.3.1": "2.3.2",
    "picomatch@^4.0.1": "^4.0.5",
    "smol-toml": "^1.7.0",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.14.0"
}
